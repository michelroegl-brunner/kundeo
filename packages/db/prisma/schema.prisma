// Kundeo database schema
// Multi-tenancy: every tenant-scoped row carries `organizationId`.
// Isolation is enforced at the database level via Postgres Row-Level Security
// (see prisma/migrations/*_rls). A self-hosted instance simply runs a single
// organization; the hosted version packs many organizations per database.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────────────────────────────────────────────────────
// Better Auth — core tables (user, session, account, verification)
// These are owned by Better Auth's Prisma adapter. Do not rename fields.
// ───────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions     Session[]
  accounts     Account[]
  members      Member[]
  invitations  Invitation[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  ipAddress            String?
  userAgent            String?
  userId               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  // set by the organization plugin to the user's active org
  activeOrganizationId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ───────────────────────────────────────────────────────────────────────────
// Better Auth — organization plugin (the tenant boundary)
// ───────────────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())

  members     Member[]
  invitations Invitation[]

  // tenant-scoped CRM data
  contacts   Contact[]
  companies  Company[]
  pipelines  Pipeline[]
  deals      Deal[]
  activities Activity[]
  tags       Tag[]

  // tenant-scoped automations
  workflows    Workflow[]
  workflowRuns WorkflowRun[]

  @@map("organization")
}

model Member {
  id             String   @id
  organizationId String
  userId         String
  role           String   @default("member")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("member")
}

model Invitation {
  id             String   @id
  organizationId String
  email          String
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

// ───────────────────────────────────────────────────────────────────────────
// CRM domain — all tenant-scoped by organizationId
// ───────────────────────────────────────────────────────────────────────────

model Company {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  domain         String?
  industry       String?
  // DACH-relevant fields
  vatId          String? // USt-IdNr. / UID
  street         String?
  postalCode     String?
  city           String?
  country        String   @default("DE") // DE | AT | CH
  phone          String?
  website        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  deals        Deal[]

  @@index([organizationId])
  @@index([organizationId, name])
  @@map("company")
}

model Contact {
  id             String   @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  // DACH formal address: "Herr" / "Frau" + optional title ("Dr.", "Prof.")
  salutation     String?
  title          String?
  position       String?
  companyId      String?
  ownerId        String? // User.id of the responsible sales rep
  notes          String?
  // DSGVO: automations may only email a contact who has given consent. Default
  // false — no consent is assumed until it is recorded (with the timestamp).
  emailConsent   Boolean   @default(false)
  emailConsentAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals        Deal[]
  activities   Activity[]
  tags         ContactTag[]

  @@index([organizationId])
  @@index([organizationId, lastName])
  @@index([organizationId, email])
  @@map("contact")
}

model Pipeline {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       Stage[]
  deals        Deal[]

  @@index([organizationId])
  @@map("pipeline")
}

model Stage {
  id          String  @id @default(cuid())
  pipelineId  String
  name        String
  order       Int
  probability Int     @default(0) // 0-100, for weighted forecast

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipelineId])
  @@map("stage")
}

model Deal {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  // amounts stored in minor units (cents) to avoid float errors
  amountCents    Int       @default(0)
  currency       String    @default("EUR") // EUR | CHF
  status         DealStatus @default(OPEN)
  pipelineId     String
  stageId        String
  companyId      String?
  contactId      String?
  ownerId        String?
  expectedCloseAt DateTime?
  renewalAt      DateTime?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage        Stage        @relation(fields: [stageId], references: [id], onDelete: Restrict)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  activities   Activity[]

  @@index([organizationId])
  @@index([organizationId, stageId])
  @@index([organizationId, status])
  @@map("deal")
}

enum DealStatus {
  OPEN
  WON
  LOST
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  type           ActivityType
  subject        String
  body           String?
  dueAt          DateTime?
  completedAt    DateTime?
  contactId      String?
  dealId         String?
  authorId       String? // User.id

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, dueAt])
  @@map("activity")
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
}

model Tag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String   @default("#6366f1")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     ContactTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("tag")
}

model ContactTag {
  contactId String
  tagId     String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tag")
}

// ───────────────────────────────────────────────────────────────────────────
// Automations — user-authored workflows (tenant-scoped by organizationId)
//
// A Workflow owns an ordered tree of WorkflowSteps. TRIGGER / ACTION / DELAY /
// FILTER steps sit on the main path (parentStepId = null). A BRANCH step's
// children carry parentStepId + branchPath (YES | NO) — that parent/child shape
// is exactly what lets the builder render its two-lane canvas. Each execution
// is a WorkflowRun with one WorkflowRunStep per step it touched: the run log.
// ───────────────────────────────────────────────────────────────────────────

model Workflow {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean  @default(false)
  version        Int      @default(1)
  createdBy      String // User.id of the author
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        WorkflowStep[]
  runs         WorkflowRun[]

  @@index([organizationId])
  @@map("workflow")
}

model WorkflowStep {
  id           String           @id @default(cuid())
  workflowId   String
  kind         WorkflowStepKind
  type         String // catalogue key, e.g. "deal.won", "task.create"
  order        Int
  parentStepId String? // null = main path; set = inside a branch lane
  branchPath   BranchPath? // null on the main path; YES | NO inside a branch
  config       Json             @default("{}")

  workflow Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  parent   WorkflowStep?  @relation("BranchChildren", fields: [parentStepId], references: [id], onDelete: Cascade)
  children WorkflowStep[] @relation("BranchChildren")

  @@index([workflowId])
  @@index([workflowId, parentStepId, order])
  @@map("workflow_step")
}

enum WorkflowStepKind {
  TRIGGER
  ACTION
  DELAY
  BRANCH
  FILTER
}

enum BranchPath {
  YES
  NO
}

model WorkflowRun {
  id                String            @id @default(cuid())
  organizationId    String
  workflowId        String
  startedAt         DateTime          @default(now())
  finishedAt        DateTime?
  status            WorkflowRunStatus
  triggeredByUserId String? // null = system-triggered (schedule / relative date)
  recordType        String? // e.g. "Deal", "Contact"
  recordId          String?
  durationMs        Int?
  // Set only while status = WAITING: when a DELAY step suspends a run, the
  // engine records when to wake it and which step to resume at. resumeStepId
  // is a soft reference (no FK), consistent with WorkflowRunStep.stepId.
  resumeAt          DateTime?
  resumeStepId      String?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow     Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  steps        WorkflowRunStep[]

  @@index([organizationId])
  @@index([organizationId, workflowId])
  @@index([workflowId, startedAt])
  // The ticker sweeps for due suspended runs: WAITING with resumeAt <= now.
  @@index([status, resumeAt])
  @@map("workflow_run")
}

// One row per step a run touched. stepId is a soft reference (no FK): run
// history must survive later edits or deletion of the workflow's steps.
model WorkflowRunStep {
  id         String                @id @default(cuid())
  runId      String
  stepId     String
  order      Int
  status     WorkflowRunStepStatus
  startedAt  DateTime              @default(now())
  durationMs Int?
  message    String?
  errorCode  String?

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("workflow_run_step")
}

enum WorkflowRunStatus {
  OK
  ERROR
  SKIPPED
  TEST
  RUNNING // in flight; a crashed process leaves runs here for recovery
  WAITING // suspended on a DELAY step until resumeAt
}

enum WorkflowRunStepStatus {
  OK
  ERROR
  SKIPPED
}
