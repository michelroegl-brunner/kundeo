// Kundeo database schema
// Multi-tenancy: every tenant-scoped row carries `organizationId`.
// Isolation is enforced at the database level via Postgres Row-Level Security
// (see prisma/migrations/*_rls). A self-hosted instance simply runs a single
// organization; the hosted version packs many organizations per database.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────────────────────────────────────────────────────
// Better Auth — core tables (user, session, account, verification)
// These are owned by Better Auth's Prisma adapter. Do not rename fields.
// ───────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions     Session[]
  accounts     Account[]
  members      Member[]
  invitations  Invitation[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  ipAddress            String?
  userAgent            String?
  userId               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  // set by the organization plugin to the user's active org
  activeOrganizationId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ───────────────────────────────────────────────────────────────────────────
// Better Auth — organization plugin (the tenant boundary)
// ───────────────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())

  members     Member[]
  invitations Invitation[]

  // tenant-scoped CRM data
  contacts   Contact[]
  companies  Company[]
  pipelines  Pipeline[]
  deals      Deal[]
  activities Activity[]
  tags       Tag[]

  // tenant-scoped automations
  workflows    Workflow[]
  workflowRuns WorkflowRun[]

  // tenant-scoped email templates (referenced by the email.send automation action)
  emailTemplates EmailTemplate[]

  // tenant-scoped FreeFinance integration (additive, capability-gated layer)
  orgIntegrations     OrgIntegration[]
  externalRefs        ExternalRef[]
  products            Product[]
  documents           Document[]
  freeFinanceSyncJobs FreeFinanceSyncJob[]

  // tenant-scoped Mahnwesen (dunning) — additive layer over invoices
  dunningPolicies DunningPolicy[]
  dunningRuns     DunningRun[]

  // MCP access — bearer keys that let external agents reach this org's CRM data
  mcpApiKeys McpApiKey[]

  @@map("organization")
}

model Member {
  id             String   @id
  organizationId String
  userId         String
  role           String   @default("member")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("member")
}

model Invitation {
  id             String   @id
  organizationId String
  email          String
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

// ───────────────────────────────────────────────────────────────────────────
// CRM domain — all tenant-scoped by organizationId
// ───────────────────────────────────────────────────────────────────────────

model Company {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  domain         String?
  industry       String?
  // DACH-relevant fields
  vatId          String? // USt-IdNr. / UID
  street         String?
  postalCode     String?
  city           String?
  country        String   @default("DE") // DE | AT | CH
  phone          String?
  website        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  deals        Deal[]

  @@index([organizationId])
  @@index([organizationId, name])
  @@map("company")
}

model Contact {
  id             String   @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  // DACH formal address: "Herr" / "Frau" + optional title ("Dr.", "Prof.")
  salutation     String?
  title          String?
  position       String?
  companyId      String?
  ownerId        String? // User.id of the responsible sales rep
  notes          String?
  // DSGVO: automations may only email a contact who has given consent. Default
  // false — no consent is assumed until it is recorded (with the timestamp).
  emailConsent   Boolean   @default(false)
  emailConsentAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals        Deal[]
  activities   Activity[]
  tags         ContactTag[]

  @@index([organizationId])
  @@index([organizationId, lastName])
  @@index([organizationId, email])
  @@map("contact")
}

model Pipeline {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       Stage[]
  deals        Deal[]

  @@index([organizationId])
  @@map("pipeline")
}

model Stage {
  id          String  @id @default(cuid())
  pipelineId  String
  name        String
  order       Int
  probability Int     @default(0) // 0-100, for weighted forecast

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipelineId])
  @@map("stage")
}

model Deal {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  // amounts stored in minor units (cents) to avoid float errors.
  // amountCents is always the *effective* value: in EFFORT mode it is
  // materialised from hoursPerWeek * hourlyRateCents * period factor, so every
  // reader (pipeline sums, forecast, automation conditions) can keep reading it.
  amountCents    Int       @default(0)
  currency       String    @default("EUR") // EUR | CHF
  // value mode: FIXED = amountCents entered directly; EFFORT = derived from effort
  valueMode      DealValueMode @default(FIXED)
  hoursPerWeek   Decimal?      @db.Decimal(6, 2)
  hourlyRateCents Int?
  effortPeriod   EffortPeriod? // basis for turning the weekly effort into amountCents
  status         DealStatus @default(OPEN)
  pipelineId     String
  stageId        String
  companyId      String?
  contactId      String?
  ownerId        String?
  expectedCloseAt DateTime?
  renewalAt      DateTime?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage        Stage        @relation(fields: [stageId], references: [id], onDelete: Restrict)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  activities   Activity[]

  @@index([organizationId])
  @@index([organizationId, stageId])
  @@index([organizationId, status])
  @@map("deal")
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum DealValueMode {
  FIXED
  EFFORT
}

enum EffortPeriod {
  WEEKLY
  MONTHLY
  ANNUAL
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  type           ActivityType
  subject        String
  body           String?
  dueAt          DateTime?
  completedAt    DateTime?
  contactId      String?
  dealId         String?
  authorId       String? // User.id

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, dueAt])
  @@map("activity")
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
}

model Tag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String   @default("#6366f1")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     ContactTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("tag")
}

model ContactTag {
  contactId String
  tagId     String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tag")
}

// Reusable email content the `email.send` automation action selects. Referenced
// by id from the step config (name denormalized as a display/log label). Body is
// Markdown with literal {{token}} placeholders substituted at send time. Managed
// from Settings → E-Mail-Vorlagen; tenant-scoped, RLS-enforced.
model EmailTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  subject        String
  body           String // Markdown with literal {{token}} placeholders
  description    String?
  category       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId, updatedAt])
  @@map("email_template")
}

// ───────────────────────────────────────────────────────────────────────────
// Automations — user-authored workflows (tenant-scoped by organizationId)
//
// A Workflow owns an ordered tree of WorkflowSteps. TRIGGER / ACTION / DELAY /
// FILTER steps sit on the main path (parentStepId = null). A BRANCH step's
// children carry parentStepId + branchPath (YES | NO) — that parent/child shape
// is exactly what lets the builder render its two-lane canvas. Each execution
// is a WorkflowRun with one WorkflowRunStep per step it touched: the run log.
// ───────────────────────────────────────────────────────────────────────────

model Workflow {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean  @default(false)
  version        Int      @default(1)
  createdBy      String // User.id of the author
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        WorkflowStep[]
  runs         WorkflowRun[]

  @@index([organizationId])
  @@map("workflow")
}

model WorkflowStep {
  id           String           @id @default(cuid())
  workflowId   String
  kind         WorkflowStepKind
  type         String // catalogue key, e.g. "deal.won", "task.create"
  order        Int
  parentStepId String? // null = main path; set = inside a branch lane
  branchPath   BranchPath? // null on the main path; YES | NO inside a branch
  config       Json             @default("{}")

  workflow Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  parent   WorkflowStep?  @relation("BranchChildren", fields: [parentStepId], references: [id], onDelete: Cascade)
  children WorkflowStep[] @relation("BranchChildren")

  @@index([workflowId])
  @@index([workflowId, parentStepId, order])
  @@map("workflow_step")
}

enum WorkflowStepKind {
  TRIGGER
  ACTION
  DELAY
  BRANCH
  FILTER
}

enum BranchPath {
  YES
  NO
}

model WorkflowRun {
  id                String            @id @default(cuid())
  organizationId    String
  workflowId        String
  startedAt         DateTime          @default(now())
  finishedAt        DateTime?
  status            WorkflowRunStatus
  triggeredByUserId String? // null = system-triggered (schedule / relative date)
  recordType        String? // e.g. "Deal", "Contact"
  recordId          String?
  durationMs        Int?
  // Set only while status = WAITING: when a DELAY step suspends a run, the
  // engine records when to wake it and which step to resume at. resumeStepId
  // is a soft reference (no FK), consistent with WorkflowRunStep.stepId.
  resumeAt          DateTime?
  resumeStepId      String?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow     Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  steps        WorkflowRunStep[]

  @@index([organizationId])
  @@index([organizationId, workflowId])
  @@index([workflowId, startedAt])
  // The ticker sweeps for due suspended runs: WAITING with resumeAt <= now.
  @@index([status, resumeAt])
  @@map("workflow_run")
}

// One row per step a run touched. stepId is a soft reference (no FK): run
// history must survive later edits or deletion of the workflow's steps.
model WorkflowRunStep {
  id         String                @id @default(cuid())
  runId      String
  stepId     String
  order      Int
  status     WorkflowRunStepStatus
  startedAt  DateTime              @default(now())
  durationMs Int?
  message    String?
  errorCode  String?

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("workflow_run_step")
}

enum WorkflowRunStatus {
  OK
  ERROR
  SKIPPED
  TEST
  RUNNING // in flight; a crashed process leaves runs here for recovery
  WAITING // suspended on a DELAY step until resumeAt
}

enum WorkflowRunStepStatus {
  OK
  ERROR
  SKIPPED
}

// ───────────────────────────────────────────────────────────────────────────
// FreeFinance integration (tenant-scoped, additive, capability-gated)
//
// Self-host works fully without this: with no credentials the feature is
// invisible. Credentials resolve env-first (single-org self-host) → per-org
// OrgIntegration row (hosted). The secret is stored as AES-GCM ciphertext, never
// plaintext, and never in Organization.metadata (which is unencrypted and read
// via the RLS-bypassing bare client). See docs/integrations/freefinance.md.
// ───────────────────────────────────────────────────────────────────────────

// Per-org integration credentials. Hosted multi-tenant layer; self-host may use
// env instead and never create a row.
model OrgIntegration {
  id             String   @id @default(cuid())
  organizationId String
  provider       String // "freefinance"
  baseUrl        String
  clientId       String
  clientSecret   String // AES-GCM ciphertext, never plaintext
  mandant        String // numeric FreeFinance client id
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId])
  @@map("org_integration")
}

// Generic external-id mapping — keeps Company/Contact/Deal/Product/Document
// provider-agnostic and gives every sync an idempotency key. entityType is one
// of "customer" | "item" | "offer" | "invoice"; entityId is the Kundeo row id.
model ExternalRef {
  id             String   @id @default(cuid())
  organizationId String
  provider       String // "freefinance"
  entityType     String
  entityId       String
  externalId     String // FreeFinance UUID
  externalNumber String? // e.g. KDN00088307, A.2026T002, R.2026T004
  syncedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, entityType, entityId])
  @@index([organizationId, provider, externalId])
  @@map("external_ref")
}

// Kundeo offering catalogue ⇄ FreeFinance items (itm/items). Prices are integer
// minor units; converted to decimals only at the FreeFinance boundary.
model Product {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  sku            String?
  unitPriceCents Int      @default(0)
  currency       String   @default("EUR")
  vatRate        Int      @default(20) // percent; mapped to a tax_class_entry
  unit           String? // FreeFinance unit_of_measure code, e.g. "H"
  account        String? // per-product income-account (Konto) override
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, active])
  @@map("product")
}

// A kind-tagged business document: OFFER (Angebot) or INVOICE (Rechnung). One
// table, one status machine and one PDF path serve both. FreeFinance remains the
// system of record for the finalized number and PDF.
model Document {
  id             String         @id @default(cuid())
  organizationId String
  kind           DocumentKind
  status         DocumentStatus @default(DRAFT)
  companyId      String?
  contactId      String?
  dealId         String?
  sourceOfferId  String? // invoice created from this offer
  currency       String         @default("EUR")
  netCents       Int            @default(0)
  taxCents       Int            @default(0)
  totalCents     Int            @default(0)
  discountValue  Decimal?       @db.Decimal(12, 4) // document-level Rabatt
  discountMode   String? // "RATE" | "CONSTANT"
  issueDate      DateTime?
  expirationDate DateTime? // offers
  dueDate        DateTime? // invoices
  paymentStatus  PaymentStatus  @default(OPEN)
  paidCents      Int            @default(0)
  externalNumber String? // A.2026T002 / R.2026T004
  eInvoice       String         @default("NONE")
  // Mahnwesen state (invoices only). dunningLevel is the highest Mahnstufe
  // already sent (0 = none). dunningPausedUntil holds the ladder (manual
  // Zahlungsvereinbarung). Payment facts (paidCents/paymentStatus) come from
  // FreeFinance read-back and stop the ladder; Kundeo owns the escalation.
  dunningLevel       Int       @default(0)
  dunningPausedUntil DateTime?
  lastDunnedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        DocumentLine[]
  dunningRuns  DunningRun[]

  @@index([organizationId, kind, status])
  // The dunning sweep selects finalized, unpaid invoices due for a Mahnung.
  @@index([organizationId, kind, paymentStatus, dunningLevel])
  @@map("document")
}

model DocumentLine {
  id             String   @id @default(cuid())
  documentId     String
  position       Int
  type           String   @default("ITEM") // "ITEM" | "TOTAL_DISCOUNT"
  productId      String?
  name           String
  itemNumber     String?
  quantity       Decimal  @db.Decimal(14, 4)
  unit           String?
  unitPriceCents Int
  discountValue  Decimal? @db.Decimal(12, 4)
  discountMode   String? // "RATE" | "CONSTANT"
  account        String? // Konto override
  vatRate        Int
  netCents       Int
  taxCents       Int
  totalCents     Int

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_line")
}

enum DocumentKind {
  OFFER
  INVOICE
}

enum DocumentStatus {
  DRAFT
  STAGING
  FINALIZED
  CANCELLED
}

enum PaymentStatus {
  OPEN
  PARTIAL
  PAID
}

// A durable queue row for the FreeFinance automation actions. An automation run
// enqueues a job (DB-only, from the post-commit outbox) rather than calling the
// API inline: network I/O must never run inside the run's transaction, and a
// FreeFinance call can be slow or fail transiently. The ticker sweeps due jobs
// and performs the sync outside any transaction, retrying with exponential
// backoff until it succeeds or exhausts maxAttempts. runId/runStepId are soft
// references back to the run log so the outcome can be written where the user
// sees it.
model FreeFinanceSyncJob {
  id             String                   @id @default(cuid())
  organizationId String
  kind           FreeFinanceSyncJobKind
  status         FreeFinanceSyncJobStatus @default(PENDING)
  companyId      String? // CUSTOMER_SYNC target / the invoice's customer
  dealId         String? // INVOICE_CREATE source deal
  documentId     String? // the created invoice, once it exists
  config         Json                     @default("{}") // finalize, account, vatRate, lineSource
  attempts       Int                      @default(0)
  maxAttempts    Int                      @default(5)
  runAt          DateTime                 @default(now()) // next attempt (backoff)
  lastError      String?
  runId          String? // originating WorkflowRun (soft ref, no FK)
  runStepId      String? // WorkflowRunStep to annotate (soft ref, no FK)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  // The ticker sweeps due pending jobs: status PENDING with runAt <= now.
  @@index([status, runAt])
  @@map("freefinance_sync_job")
}

enum FreeFinanceSyncJobKind {
  CUSTOMER_SYNC
  INVOICE_CREATE
}

enum FreeFinanceSyncJobStatus {
  PENDING
  DONE
  FAILED
}

// ---------------------------------------------------------------------------
// Mahnwesen (dunning) — an additive layer over finalized invoices.
//
// Kundeo owns the whole dunning process: the FreeFinance 2.0 API exposes no
// reminder/Mahnung resource, so Kundeo computes Verzugszinsen + Mahngebühren,
// escalates through a configurable ladder and sends each Mahnung by email
// (attaching the original FreeFinance invoice PDF). The escalation runs on the
// same in-process ticker as the automation delays and FreeFinance job sweep.
// ---------------------------------------------------------------------------

// One dunning configuration per organization. graceDays is the wait after the
// invoice due date before the first Mahnstufe; intervalDays is the cadence
// between subsequent Stufen. The concrete ladder lives in DunningLevel rows.
model DunningPolicy {
  id             String   @id @default(cuid())
  organizationId String
  isActive       Boolean  @default(true)
  graceDays      Int      @default(3)
  intervalDays   Int      @default(7)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  levels       DunningLevel[]

  @@unique([organizationId])
  @@map("dunning_policy")
}

// One rung of the ladder. level 1..N (1 = Zahlungserinnerung). feeCents is the
// Mahngebühr for this Stufe; interestBps is the annual Verzugszinssatz in basis
// points, applied pro-rata over the days overdue. Each Stufe may point at an
// email template; a null template falls back to a built-in body.
model DunningLevel {
  id              String  @id @default(cuid())
  policyId        String
  level           Int
  label           String
  feeCents        Int     @default(0)
  interestBps     Int     @default(0)
  emailTemplateId String?

  policy DunningPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, level])
  @@index([policyId])
  @@map("dunning_level")
}

// The audit trail: one row per Mahnung actually sent, shown in the invoice's
// Verlauf. Carries the computed amounts and the email outcome so the history is
// truthful even when no mail transport is configured (delivered = false).
model DunningRun {
  id             String   @id @default(cuid())
  organizationId String
  documentId     String
  level          Int
  label          String
  feeCents       Int      @default(0)
  interestCents  Int      @default(0)
  openCents      Int      @default(0) // invoice open amount at the time of the run
  emailStatus    String // "SENT" | "LOGGED" | "SKIPPED"
  detail         String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId, documentId])
  @@map("dunning_run")
}

// ───────────────────────────────────────────────────────────────────────────
// MCP (Model Context Protocol) — bearer keys for external agents
//
// A key authorizes an external MCP client (Claude Cowork, Claude Desktop, …) to
// reach a single organization's CRM data through /api/mcp. The plaintext token
// is shown once at creation; only its SHA-256 hash is stored.
//
// Unlike the CRM tables, this is auth *infrastructure*, not tenant data: the
// endpoint must resolve a token to its organization BEFORE any org context
// exists, so the lookup runs on the bare client (like Better Auth's own
// user/session/organization tables). It is therefore deliberately NOT placed
// under Row-Level Security (see prisma/rls.sql) — the management UI scopes it
// explicitly by organizationId and gates it on an admin role instead. Every
// query the resolved key then makes into CRM tables still goes through
// withOrg(), so RLS applies to the actual data access.
model McpApiKey {
  id              String    @id @default(cuid())
  organizationId  String
  name            String
  keyHash         String    @unique // sha256 hex of the bearer token
  keyPrefix       String // display hint, e.g. "kundeo_mcp_1a2b3c4d"
  createdByUserId String? // User.id of the creator (soft ref, like ownerId)
  scope           String    @default("read_write") // "read_only" | "read_write"
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("mcp_api_key")
}
