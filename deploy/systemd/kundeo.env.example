# Kundeo native install config — copy to /opt/kundeo/kundeo.env and fill in.
# Read by the systemd unit (EnvironmentFile) and by bin/migrate.sh.
# Assumes a PostgreSQL reachable from this host with the restricted `kundeo_app`
# role created (see deploy/postgres/init.sql).

# Runtime connection: restricted role that RLS applies to.
DATABASE_URL="postgresql://kundeo_app:kundeo_app@127.0.0.1:5432/kundeo?schema=public"
# Owner connection for migrations (bypasses RLS).
DIRECT_URL="postgresql://kundeo:change-me@127.0.0.1:5432/kundeo?schema=public"

# Auth signing secret. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
# Public base URL the app is served at.
BETTER_AUTH_URL="https://crm.example.com"

# Encrypts integration secrets at rest. Generate: openssl rand -base64 32
KUNDEO_ENCRYPTION_KEY="change-me"

# "self-hosted" (default) or "hosted".
KUNDEO_EDITION="self-hosted"
# Email delivery: "log" (default), "smtp", or "m365".
KUNDEO_EMAIL_PROVIDER="log"
