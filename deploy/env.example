# Kundeo production stack (deploy/docker-compose.yml).
# Copy to deploy/.env and fill in. Never commit the real .env.

# ─── Secrets (required) ──────────────────────────────────────────────────────
# Password for the `kundeo` DB owner role. Used by Postgres on first boot and
# by migrations (DIRECT_URL). Generate: openssl rand -base64 24
POSTGRES_PASSWORD="change-me"

# Auth signing secret. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"

# Encrypts integration secrets at rest. Generate: openssl rand -base64 32
KUNDEO_ENCRYPTION_KEY="change-me"

# Public base URL the app is served at (used for auth callbacks & links).
BETTER_AUTH_URL="https://crm.example.com"

# ─── Optional ────────────────────────────────────────────────────────────────
# Image to run. Pin a released version in production instead of :latest.
# KUNDEO_IMAGE="ghcr.io/michelroegl-brunner/kundeo:0.1.0"

# Host port to publish the app on (container always listens on 3000).
# KUNDEO_PORT="3000"

# "self-hosted" (default, single org) or "hosted" (org per signup).
# KUNDEO_EDITION="self-hosted"

# Email delivery: "log" (default), "smtp", or "m365". For smtp/m365 add the
# matching KUNDEO_SMTP_* / KUNDEO_M365_* vars to the app service.
# KUNDEO_EMAIL_PROVIDER="log"
