# ─── Database ────────────────────────────────────────────────────────────────
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://kundeo:kundeo@localhost:5432/kundeo?schema=public"
# Direct (non-pooled) connection used by Prisma Migrate.
DIRECT_URL="postgresql://kundeo:kundeo@localhost:5432/kundeo?schema=public"

# ─── Auth (Better Auth) ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
BETTER_AUTH_URL="http://localhost:3000"
