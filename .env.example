# ─── Database ────────────────────────────────────────────────────────────────
# Runtime connection: the limited `kundeo_app` role that RLS applies to.
DATABASE_URL="postgresql://kundeo_app:kundeo_app@localhost:5434/kundeo?schema=public"
# Migration/seed connection: the owning role (bypasses RLS). Used by Prisma Migrate.
DIRECT_URL="postgresql://kundeo:kundeo@localhost:5434/kundeo?schema=public"

# ─── Auth (Better Auth) ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
BETTER_AUTH_URL="http://localhost:3000"

# ─── Microsoft Entra ID login (optional) ─────────────────────────────────────
# Sign in with a Microsoft work/school account. Leave all three unset to hide
# the button and run email/password only. Create an app registration in the
# Entra admin center (single tenant), add the redirect URI
#   ${BETTER_AUTH_URL}/api/auth/callback/microsoft
# then copy the values below. ENTRA_TENANT_ID must be your tenant GUID or a
# verified domain — NOT "common" (that would allow any Microsoft account).
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""
ENTRA_TENANT_ID=""

# ─── Deployment edition ──────────────────────────────────────────────────────
# "self-hosted" (default) bootstraps a single org for the first user.
# "hosted" creates a new org per signup. Keep self-hosted unless running the SaaS.
KUNDEO_EDITION="self-hosted"

# ─── Integrations ────────────────────────────────────────────────────────────
# Encrypts integration secrets (e.g. the FreeFinance client secret) at rest.
# Required before connecting an integration whose credentials live in the DB —
# there is no fallback key. Generate with: openssl rand -base64 32
KUNDEO_ENCRYPTION_KEY="change-me"
